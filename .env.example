# AppFlow environment variables — copy to .env and fill in.
# See DEPLOYMENT.md for details. Never commit real values in .env.

# --- Required: app will not start without these ---
DATABASE_URL=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# --- Required: AI features ---
ANTHROPIC_API_KEY=

# --- Optional: GitHub OAuth (Evidence Center) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional: Google OAuth (Login with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: public app URL ---
NEXT_PUBLIC_APP_URL=
